# Autbank Portal - Configurações
# Copie este arquivo para .env e preencha os valores

# URL base do portal Autbank (página de login)
AUTBANK_BASE_URL=https://central.autbank.com.br/regatendimentoext/faces/reindex.jsp

# URL da página inicial/landing (opcional - se não definido, usa AUTBANK_BASE_URL)
# Use quando houver uma página inicial com link que abre o portal em nova aba
# AUTBANK_LANDING_URL=https://central.autbank.com.br/

# Seletor do link que abre o portal (opcional - usa padrão do selectors se não definido)
# Ex: a[href*="reindex"] ou #linkPortal
# AUTBANK_PORTAL_LINK_SELECTOR=

# Usar troca de janela após clique no link (true/false). Se false, navega direto para o portal.
# Use false quando o portal carrega na mesma janela (navegação direta)
AUTBANK_USE_WINDOW_SWITCH=true

# Credenciais (NUNCA commitar o .env com credenciais reais)
AUTBANK_EMAIL=
AUTBANK_PASSWORD=

# Navegador: chrome | edge
BROWSER=chrome

# Modo headless: true | false
HEADLESS=false

# Timeouts em milissegundos
TIMEOUT_PAGE_LOAD=30000
TIMEOUT_ELEMENT=15000
TIMEOUT_IMPLICIT=5000

# Porta do servidor
PORT=3001
